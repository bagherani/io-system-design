PORT=3016

# S3 bucket that will store uploaded objects.
S3_BUCKET_NAME=your-bucket-name
AWS_REGION=eu-central-1

# Use credentials for an IAM user or role that can s3:PutObject and s3:GetObject
# on the bucket above. Keep the real values in 06-blob-storage/.env.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Only needed when using temporary credentials from AWS STS, SSO, or an assumed role.
# AWS_SESSION_TOKEN=your-session-token

# Signed URLs are short-lived by design. 900 seconds = 15 minutes.
SIGNED_URL_EXPIRES_SECONDS=900
